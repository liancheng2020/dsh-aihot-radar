{
  "name": "dsh-aihot-radar",
  "version": "0.2.0",
  "description": "AIHOT 雷达 + 资讯值班：Codex/Claude/Antigravity 额度重置实时推送，外加 AIHOT 资讯 Agent 工具。免 Key、零运行时依赖。",
  "author": "liancheng2020",
  "type": "module",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2"
  },
  "main": "index.js",
  "scripts": {
    "selftest": "node scripts/selftest.mjs",
    "selftest:client": "node scripts/selftest-client.mjs",
    "verify:dedup": "node scripts/verify-dedup.mjs"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "assets",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2+": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "aihot",
    "AI资讯",
    "额度重置",
    "Codex",
    "Claude",
    "Antigravity",
    "日报",
    "免费",
    "免Key",
    "antigravity",
    "quota",
    "reset",
    "webhook",
    "wecom",
    "dingtalk",
    "feishu",
    "telegram",
    "digest",
    "monitor",
    "ai-news"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liancheng2020/dsh-aihot-radar.git"
  },
  "homepage": "https://github.com/liancheng2020/dsh-aihot-radar"
}